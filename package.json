{
  "name": "finecars-goerlitz",
  "version": "1.0.0",
  "private": true,
  "description": "Website von FineCars Görlitz – statischer Build ohne Laufzeitabhängigkeiten",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.js",
    "dev": "node scripts/serve.js --watch",
    "start": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "check": "node build.js && node scripts/check.js",
    "release": "FINECARS_RELEASE=1 node build.js && node scripts/check.js",
    "export": "node scripts/export-static.js"
  }
}
